# Copie para .env e troque os valores: cp .env.example .env
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).

# Banco de dados
POSTGRES_DB=ringside
POSTGRES_USER=ringside
POSTGRES_PASSWORD=troque-esta-senha

# Segurança (gere com: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRA_MINUTOS=60

# Administrador criado pelo seed
ADMIN_EMAIL=booker@ringside.local
ADMIN_SENHA=troque-esta-senha-tambem

# CORS: única origem que pode chamar a API
FRONTEND_ORIGEM=http://localhost:5173

# Endereço da API visto pelo navegador
VITE_API_URL=http://localhost:8000
